{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two environments only: `--env dev` (Worker `sixpm-api-dev`) and `--env prd` (`sixpm-api`).
  // Bindings are not inherited, so each environment declares its own. Local runs and the tests use
  // `dev` with simulated bindings, which need no Cloudflare account.
  // Each environment owns `<host>/api/*` on at6pm.app (prd `at6pm.app`, dev `dev.at6pm.app`), and the
  // website serves the rest of the host. The hosts before at6pm.app, on oddeggs.studio, keep their
  // routes so builds and forwarding addresses made before the move keep working.
  "name": "sixpm-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Secrets are set per environment with `wrangler secret put <NAME> --env <dev|prd>`; their names
  // are listed in `src/env.ts`.
  // Email Routing delivers `*@<host>` to this Worker's `email` handler (receipt email); that rule
  // lives in the zone's Email Routing settings, not here.
  "env": {
    "dev": {
      "name": "sixpm-api-dev",
      // Run near Singapore: close to D1 (APAC), and Anthropic does not take requests from the
      // Hong Kong data center that serves Vietnam by default.
      "placement": { "region": "aws:ap-southeast-1" },
      "routes": [
        { "pattern": "dev.at6pm.app/api/*", "zone_name": "at6pm.app" },
        { "pattern": "6pm-dev.oddeggs.studio/api/*", "zone_name": "oddeggs.studio" },
      ],
      // COMMIT_SHA is overridden at deploy time (`--var COMMIT_SHA:<sha>`).
      // VOICE_PROVIDER picks the realtime transcriber (`deepgram` or `elevenlabs`); its key is a
      // secret. ELEVENLABS_ZERO_RETENTION is `true` only once the ElevenLabs account has zero
      // retention, which turns its logging off.
      "vars": {
        "ENVIRONMENT": "dev",
        "COMMIT_SHA": "local",
        "VOICE_PROVIDER": "elevenlabs",
        "ELEVENLABS_ZERO_RETENTION": "false",
      },
      // Exchange rates in đồng, four times a day: the travel currencies every run, the rest of the
      // currency table in turns (`currenciesForRun`). The ingest is idempotent.
      "triggers": { "crons": ["20 */6 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sixpm-dev",
          "database_id": "94cb7646-0777-4a00-bb3f-fb944421f4e6",
          "migrations_dir": "migrations",
        },
      ],
      // FILES holds the sealed backups under `backups/<token hash>`; nothing in it is readable.
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "sixpm-dev" }],
      // Rate limit namespaces need no resource: the id is any integer unique within the account.
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "6301",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "6302",
          "simple": { "limit": 60, "period": 60 },
        },
        // A backup is a few megabytes and made about once a day: one token and one address each
        // get a small allowance (see `limitByBackup`).
        {
          "name": "BACKUP_RATE_LIMIT",
          "namespace_id": "6303",
          "simple": { "limit": 12, "period": 60 },
        },
        // Mail to one receipt address: a person forwards a handful a day, a filter a few at once.
        {
          "name": "EMAIL_RATE_LIMIT",
          "namespace_id": "6304",
          "simple": { "limit": 20, "period": 60 },
        },
        // A receipt photo the phone could not read goes to the vision model: a person shares a few
        // a day, so one device and one address each get a small allowance (see `limitReceiptReads`).
        {
          "name": "RECEIPT_READ_RATE_LIMIT",
          "namespace_id": "6305",
          "simple": { "limit": 10, "period": 60 },
        },
        // A category icon the phone's word match could not find goes to the decision model: the
        // phone asks after a pause in the typing, so one device gets a small allowance.
        {
          "name": "ICON_PICK_RATE_LIMIT",
          "namespace_id": "6306",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
    "prd": {
      "name": "sixpm-api",
      // Run near Singapore: close to D1 (APAC), and Anthropic does not take requests from the
      // Hong Kong data center that serves Vietnam by default.
      "placement": { "region": "aws:ap-southeast-1" },
      "routes": [
        { "pattern": "at6pm.app/api/*", "zone_name": "at6pm.app" },
        { "pattern": "6pm.oddeggs.studio/api/*", "zone_name": "oddeggs.studio" },
      ],
      // VOICE_PROVIDER picks the realtime transcriber (`deepgram` or `elevenlabs`); its key is a
      // secret. ELEVENLABS_ZERO_RETENTION is `true` only once the ElevenLabs account has zero
      // retention, which turns its logging off.
      "vars": {
        "ENVIRONMENT": "prd",
        "COMMIT_SHA": "local",
        "VOICE_PROVIDER": "elevenlabs",
        "ELEVENLABS_ZERO_RETENTION": "false",
      },
      "triggers": { "crons": ["20 */6 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sixpm",
          "database_id": "94098e3b-7564-4e44-9331-cf4646e0a5ec",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "sixpm" }],
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "6311",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "6312",
          "simple": { "limit": 60, "period": 60 },
        },
        // A backup is a few megabytes and made about once a day: one token and one address each
        // get a small allowance (see `limitByBackup`).
        {
          "name": "BACKUP_RATE_LIMIT",
          "namespace_id": "6313",
          "simple": { "limit": 12, "period": 60 },
        },
        // Mail to one receipt address: a person forwards a handful a day, a filter a few at once.
        {
          "name": "EMAIL_RATE_LIMIT",
          "namespace_id": "6314",
          "simple": { "limit": 20, "period": 60 },
        },
        // A receipt photo the phone could not read goes to the vision model: a person shares a few
        // a day, so one device and one address each get a small allowance (see `limitReceiptReads`).
        {
          "name": "RECEIPT_READ_RATE_LIMIT",
          "namespace_id": "6315",
          "simple": { "limit": 10, "period": 60 },
        },
        // A category icon the phone's word match could not find goes to the decision model: the
        // phone asks after a pause in the typing, so one device gets a small allowance.
        {
          "name": "ICON_PICK_RATE_LIMIT",
          "namespace_id": "6316",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
    },
  },
}
