# Selects the app.config.ts variant: dev | prd | e2e-test. Unset means dev.
APP_VARIANT=dev
# RevenueCat's public iOS SDK key (appl_…). Set in eas.json for prd; unset, purchases show as unavailable.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# RevenueCat's public Android SDK key (goog_…). Set in eas.json for prd; unset, purchases show as unavailable.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Sentry crash reports (public DSN). Set in eas.json; SENTRY_AUTH_TOKEN (a CI secret) enables symbol upload.
EXPO_PUBLIC_SENTRY_DSN=
