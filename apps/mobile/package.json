    "expo-application": "catalog:",
    "expo-asset": "catalog:",
    "expo-blur": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-camera": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-device": "catalog:",
    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-location": "catalog:",
    "expo-media-library": "catalog:",
    "expo-notifications": "catalog:",
    "expo-print": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-speech-recognition": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-updates": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-native-keychain": "catalog:",
    "react-native-purchases": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-worklets": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@bacons/apple-targets": "catalog:",
    "@jest/globals": "catalog:",
    "@react-native/jest-preset": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "expo-doctor": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
