---
interface Props {
  /** "FRI 6 NOV, 18:00". */
  launchUpper: string;
}

const { launchUpper } = Astro.props;
---

<section class="credits">
  <span class="presents">6PM PRESENTS</span>
  <div class="version numeral">2.0</div>
  <p class="tagline">The day you finally knew where it went.</p>
  <p class="billing">
    A little sun production · starring you · co-starring your wallet · one number · one swipe ·
    zero spreadsheets · filmed entirely at six o’clock
  </p>
  <div class="release">
    <span class="rule"></span>ON iPHONE · <span>{launchUpper}</span><span class="rule"></span>
  </div>
</section>

<style>
  .credits {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    box-sizing: border-box;
    padding: 120px 20px 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    text-align: center;
  }
  .presents {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.42em;
    color: var(--ink-70);
  }
  .version {
    font-size: min(44vw, 62vh);
    line-height: 0.96;
    padding: 0.06em 0.08em 0;
    letter-spacing: -0.06em;
    background: linear-gradient(180deg, #fff4dc 0%, #ffc46b 38%, #ff6b35 66%, #b8336a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 70px rgba(255, 107, 53, 0.35));
  }
  .tagline {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 2.8vw, 40px);
    line-height: 1.15;
    max-width: 760px;
    text-wrap: balance;
  }
  .billing {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-mono);
    font-size: clamp(10.5px, 0.95vw, 12.5px);
    letter-spacing: 0.2em;
    line-height: 2;
    color: var(--ink-60);
    text-transform: uppercase;
    text-wrap: balance;
  }
  .release {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.1vw, 14px);
    font-weight: 600;
    letter-spacing: 0.2em;
  }
  .rule {
    width: 40px;
    height: 1px;
    background: rgba(251, 244, 236, 0.4);
  }
</style>
