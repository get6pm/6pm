---
import { ticks } from '../data/story';
---

<section class="dial-scene" data-scene="dial">
  <div class="stage" data-shake>
    <div class="words">
      <h2 class="headline">Sixty seconds was <span class="too-long">too long.</span></h2>
      <div class="vi-line" lang="vi">Sáu mươi giây là quá lâu.</div>
    </div>
    <div class="dial" aria-hidden="true">
      <div class="ring"></div>
      {
        ticks.map((t) => (
          <div
            class="tick"
            style={`--i:${t.i};width:${t.w};height:${t.h};transform:translate(-50%,-50%) rotate(${t.angle}) translateY(calc(var(--D) * -.44))`}
          />
        ))
      }
      <div class="hand"></div>
      <div class="pin"></div>
      <div class="face">
        <div class="face-seconds">
          <span class="big" data-seconds>60</span>
          <span class="unit">SECONDS</span>
        </div>
        <div class="face-swipe">
          <span class="big big-one">1</span>
          <span class="unit">SWIPE</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dial-scene {
    position: relative;
    height: 260vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    box-sizing: border-box;
    max-width: 1320px;
    margin: 0 auto;
    padding: 96px clamp(20px, 6vw, 88px) 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: center;
    gap: clamp(20px, 4vw, 64px);
  }
  .words {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }
  .words .headline {
    font-size: clamp(50px, 7.4vw, 124px);
    text-wrap: wrap;
  }
  .too-long {
    display: inline-block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: calc((1 - var(--k, 0)) * 0.42em - 0.045em);
    font-variation-settings: 'wdth' calc(100 - var(--k, 0) * 25);
  }
  .dial {
    --D: min(66vmin, 560px);
    position: relative;
    width: var(--D);
    height: var(--D);
    justify-self: center;
  }
  .ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border-radius: 50%;
    border: 3px solid var(--accent);
    opacity: calc(
      clamp(0, (var(--k, 0) - 0.84) * 30, 1) * (1 - clamp(0, (var(--k, 0) - 0.86) * 9, 1))
    );
    transform: scale(calc(0.6 + clamp(0, (var(--k, 0) - 0.84) * 7, 1) * 1.3));
    pointer-events: none;
  }
  .tick {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 3px;
    background: var(--ink);
    opacity: calc(0.1 + 0.9 * (1 - clamp(0, var(--k, 0) * 74 - var(--i), 1)));
  }
  .hand {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: calc(var(--D) * 0.4);
    margin-left: -1.5px;
    border-radius: 3px;
    background: var(--accent);
    transform-origin: 50% 0;
    transform: rotate(calc(180deg + var(--k, 0) * 300deg));
    box-shadow: 0 0 18px rgba(255, 133, 82, 0.6);
  }
  .pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin: -7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .face {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    background: rgba(16, 10, 28, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .face-seconds,
  .face-swipe {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .face-seconds {
    gap: 4px;
    opacity: calc(1 - clamp(0, (var(--k, 0) - 0.8) * 8, 1));
  }
  .face-swipe {
    gap: 6px;
    opacity: clamp(0, (var(--k, 0) - 0.82) * 8, 1);
    transform: scale(calc(0.8 + clamp(0, (var(--k, 0) - 0.82) * 8, 1) * 0.2));
  }
  .big {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(var(--D) * 0.26);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .big-one {
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--accent);
    font-variant-numeric: normal;
  }
  .unit {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(251, 244, 236, 0.75);
  }
</style>
