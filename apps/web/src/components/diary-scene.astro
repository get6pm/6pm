---
import { diaryTiles } from '../data/story';
---

<section class="diary" data-scene="diary">
  <div class="stage">
    <div class="top">
      <div class="words">
        <span class="eyebrow">THIRTY DAYS LATER</span>
        <h2 class="headline">A diary that <em>keeps receipts.</em></h2>
        <div class="vi-line" lang="vi">Cuốn nhật ký giữ lại từng hoá đơn.</div>
      </div>
      <div class="saved">
        <span class="saved-amount numeral" data-saved>+0₫</span>
        <span class="saved-label">SENT TO FUTURE YOU</span>
      </div>
    </div>
    <div class="days" aria-hidden="true">
      {
        diaryTiles.map((d) => (
          <div class:list={['day', { open: d.open }]} style={`--r:${d.tilt}`}>
            <span class="dow">{d.dow}</span>
            <span class="n">{d.n}</span>
            <span class="spent">
              <span class:list={['dot', { over: d.over }]} />
              {d.amount}
            </span>
            {!d.open && (
              <span class="stamp" data-stamp>
                CLOSED
              </span>
            )}
          </div>
        ))
      }
      <div class="sticky-note">
        september you was steady. october you, keep going.<br /><span>— 6pm</span>
      </div>
    </div>
  </div>
</section>

<style>
  .diary {
    position: relative;
    height: 250vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(56px, 9vh, 84px) clamp(20px, 6vw, 88px) clamp(14px, 3vh, 30px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 2.6vh, 28px);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .words {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
  }
  .saved {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }
  .saved-amount {
    font-size: clamp(48px, 6.4vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--saved);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 40px rgba(159, 224, 182, 0.3);
  }
  .saved-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--ink-70);
  }
  .days {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(78px, 1fr));
    gap: clamp(6px, 1.2vh, 10px);
  }
  .day {
    position: relative;
    box-sizing: border-box;
    height: clamp(54px, 8.6vh, 86px);
    transform: rotate(var(--r));
    padding: 10px 10px 9px;
    border-radius: 4px;
    background: var(--paper);
    color: var(--paper-ink);
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 12px 22px rgba(5, 2, 12, 0.32);
    --sub: rgba(43, 37, 48, 0.6);
  }
  .day.open {
    background: transparent;
    border: 1.5px dashed rgba(251, 244, 236, 0.35);
    box-shadow: none;
    --sub: rgba(251, 244, 236, 0.55);
  }
  .dow {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    color: var(--sub);
  }
  .n {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--paper-ink);
  }
  .open .n {
    color: rgba(251, 244, 236, 0.6);
  }
  .spent {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    color: var(--sub);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3f9a6a;
  }
  .dot.over {
    background: #e0705a;
  }
  .open .dot {
    background: transparent;
  }
  .stamp {
    position: absolute;
    right: 6px;
    top: 8px;
    padding: 2px 4px 1px;
    border: 1.5px solid var(--stamp);
    color: var(--stamp);
    border-radius: 3px;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.1em;
    opacity: 0;
  }
  .stamp[data-on] {
    opacity: 0.94;
    transform: rotate(-8deg);
    animation: stampIn 0.32s cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }
  .sticky-note {
    --on: clamp(0, (var(--k, 0) - 0.8) * 8, 1);
    grid-column: span 2;
    box-sizing: border-box;
    min-height: clamp(54px, 8.6vh, 86px);
    opacity: var(--on);
    transform: rotate(2.5deg) scale(calc(1.3 - var(--on) * 0.3));
    padding: 14px 16px;
    background: #f8e58c;
    color: #3a2a14;
    font-family: var(--font-hand);
    font-size: 23px;
    line-height: 1.1;
    box-shadow: 0 14px 26px rgba(5, 2, 12, 0.35);
  }
  .sticky-note span {
    font-size: 18px;
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp[data-on] {
      animation: fadeIn 0.2s both;
    }
  }
</style>
