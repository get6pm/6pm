---
interface Props {
  /** "FRI 6 NOV, 18:00". */
  launchUpper: string;
  clock: string;
}

const { launchUpper, clock } = Astro.props;
---

<section id="top" class="hero" data-scene="hero">
  <div class="stage">
    <div class="sky-band">
      <div class="sun"></div>
    </div>
    <div class="sea" aria-hidden="true">
      <div class="reflection">
        <div class="sun-reflection"></div>
        <div class="word word-reflection">6pm</div>
      </div>
      <div class="glint glint-1 loop"></div>
      <div class="glint glint-2 loop"></div>
      <div class="glint glint-3 loop"></div>
    </div>
    <div class="halftone" aria-hidden="true"></div>
    <h1 class="word word-main">6pm</h1>
    <div class="horizon" aria-hidden="true"></div>
    <div class="side-leak loop" aria-hidden="true"></div>
    <div class="flare-wide" aria-hidden="true"></div>
    <div class="flare-line" aria-hidden="true"></div>

    <div class="scroll-cue loop" aria-hidden="true"></div>
    <div class="clock" aria-hidden="true"><span data-clock>{clock}</span></div>
    <div class="caption">
      <span class="launch">6PM 2.0 · {launchUpper}</span>
      <p class="its-six">It’s six. <span lang="vi">Sáu giờ rồi.</span></p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 240vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .sky-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 64%;
    overflow: hidden;
    background: linear-gradient(180deg, var(--h0) 0%, var(--h1) 62%, var(--h2) 100%);
  }
  .sun,
  .sun-reflection {
    position: absolute;
    left: 50%;
    width: 40vmin;
    height: 40vmin;
    margin: -20vmin 0 0 -20vmin;
    border-radius: 50%;
  }
  .sun {
    top: calc(14% + var(--k, 0) * 96%);
    background: color-mix(in oklch, #fff4dc, #ff7a45 calc(var(--k, 0) * 100%));
    box-shadow:
      0 0 10vmin 5vmin color-mix(in oklch, #ffd7a0 70%, transparent),
      0 0 46vmin 24vmin color-mix(in oklch, #ff9a6a 34%, transparent);
  }
  .sea {
    position: absolute;
    left: 0;
    right: 0;
    top: 64%;
    bottom: 0;
    overflow: hidden;
    background: linear-gradient(180deg, var(--sea0) 0%, #0b0716 92%);
  }
  .reflection {
    position: absolute;
    inset: 0;
    filter: url(#ripple);
    opacity: 0.6;
  }
  .sun-reflection {
    top: calc(64vh * (0.86 - 0.96 * var(--k, 0)));
    background: color-mix(in oklch, #ffe8c4, #ff7a45 calc(var(--k, 0) * 100%));
    filter: blur(6px);
  }
  .word {
    margin: 0;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: min(40vw, 50vh);
    line-height: 0.74;
    letter-spacing: -0.035em;
    font-variation-settings:
      'wdth' 75,
      'opsz' 96;
    color: var(--sun-ink);
    white-space: nowrap;
  }
  .word-reflection {
    position: absolute;
    top: 0;
    transform: scaleY(-0.62);
    transform-origin: 50% 0;
  }
  .word-main {
    position: absolute;
    top: 64%;
    transform: translateY(-100%);
    pointer-events: none;
    text-shadow:
      0 -1px 0 rgba(255, 200, 150, calc(0.55 - var(--k, 0) * 0.5)),
      0 0 40px rgba(255, 170, 110, calc(0.35 - var(--k, 0) * 0.35));
  }
  .glint {
    position: absolute;
    height: 2px;
    border-radius: 2px;
    animation: shimmer 2.6s infinite;
  }
  .glint-1 {
    left: 18%;
    right: 18%;
    top: 14%;
    background: rgba(255, 226, 200, 0.55);
  }
  .glint-2 {
    left: 30%;
    right: 30%;
    top: 26%;
    background: rgba(255, 226, 200, 0.4);
    animation-delay: 0.7s;
  }
  .glint-3 {
    left: 40%;
    right: 40%;
    top: 38%;
    background: rgba(255, 226, 200, 0.3);
    animation-delay: 1.4s;
  }
  .halftone {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    height: 30%;
    pointer-events: none;
    opacity: 0.16;
    background-image: radial-gradient(circle, rgba(255, 236, 214, 0.95) 1px, transparent 1.6px);
    background-size: 6px 6px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 70%);
    mask-image: linear-gradient(180deg, transparent, #000 70%);
  }
  .horizon {
    position: absolute;
    left: 0;
    right: 0;
    top: 64%;
    height: 1px;
    margin-top: -0.5px;
    background: radial-gradient(
      50% 100% at 50% 50%,
      rgba(255, 214, 170, calc(1 - var(--k, 0) * 0.7)),
      rgba(255, 214, 170, 0)
    );
    pointer-events: none;
  }
  .side-leak {
    position: absolute;
    left: 0;
    top: 0;
    width: 38vw;
    height: 64%;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(70% 50% at 0% 30%, var(--b1), transparent 70%);
    opacity: calc(0.25 + var(--k, 0) * 0.5);
    animation: leak 8s ease-in-out infinite alternate;
  }
  .flare-wide,
  .flare-line {
    position: absolute;
    top: 64%;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .flare-wide {
    left: -15%;
    right: -15%;
    height: 46px;
    margin-top: -23px;
    background: linear-gradient(
      90deg,
      transparent 4%,
      var(--b2) 34%,
      #fff6e8 50%,
      var(--b2) 66%,
      transparent 96%
    );
    filter: blur(16px);
    opacity: clamp(0, var(--k, 0) * 1.4 - 0.1, 0.55);
  }
  .flare-line {
    left: -5%;
    right: -5%;
    height: 2px;
    margin-top: -1px;
    background: linear-gradient(
      90deg,
      transparent 6%,
      var(--b2) 36%,
      #fffaf0 50%,
      var(--b2) 64%,
      transparent 94%
    );
    opacity: clamp(0, var(--k, 0) * 1.6 - 0.2, 0.95);
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(96px, 14vh, 140px);
    width: 1px;
    height: 44px;
    background: linear-gradient(180deg, rgba(251, 244, 236, 0), rgba(251, 244, 236, 0.8));
    opacity: calc(1 - var(--k, 0) * 3);
    animation: shimmer 2s infinite;
  }
  .clock {
    position: absolute;
    z-index: 2;
    right: clamp(72px, 8vw, 120px);
    top: clamp(84px, 13vh, 128px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    color: var(--sun-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(34px, 5vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(24px, 5vh, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    padding: 0 20px;
  }
  .launch {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(251, 244, 236, 0.85);
    opacity: calc(1 - var(--k, 0) * 1.6);
  }
  .its-six {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 60px);
    letter-spacing: -0.02em;
    line-height: 1;
    opacity: clamp(0, (var(--k, 0) - 0.82) * 7, 1);
    transform: translateY(calc((1 - clamp(0, (var(--k, 0) - 0.82) * 7, 1)) * 16px));
  }
  .its-six span {
    color: rgba(251, 244, 236, 0.6);
  }
</style>
