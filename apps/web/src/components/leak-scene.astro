---
import { chips } from '../data/story';
---

<section class="leak" data-scene="leak">
  <div class="stage" data-shake>
    <div class="dusk" aria-hidden="true"></div>
    <div class="swarm" aria-hidden="true">
      {
        chips.map((c) => (
          <div class="chip" data-chip>
            <span class="tile" style={`background:${c.tile};color:${c.glyph}`}>
              <span class="icon icon-filled">{c.icon}</span>
            </span>
            <span class="name">{c.name}</span>
            <span class="amount">−{c.amount}</span>
          </div>
        ))
      }
    </div>
    <div class="burst" aria-hidden="true"></div>
    <div class="counter">
      <span class="counter-label">SPENT THIS MONTH · ON THINGS YOU CAN’T REMEMBER</span>
      <span class="counter-number numeral" data-leak-number>0₫</span>
    </div>
    <div class="stop numeral" aria-hidden="true">Stop.</div>
    <div class="answer">
      <h2 class="headline">6pm catches <em>all of it.</em></h2>
      <div class="vi" lang="vi">Không sót một đồng nào.</div>
      <p class="lede">
        Bank alerts, VietQR and shared receipts arrive named and priced. You just say yes.
      </p>
    </div>
    <div class="bar bar-top" aria-hidden="true"></div>
    <div class="bar bar-bottom" aria-hidden="true"></div>
  </div>
</section>

<style>
  .leak {
    position: relative;
    height: 380vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    perspective: 900px;
    perspective-origin: 50% 50%;
  }
  .dusk {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 50%, rgba(40, 14, 40, 0.25), rgba(3, 1, 8, 0.78) 85%);
  }
  .swarm {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  .chip {
    position: absolute;
    left: 0;
    top: 0;
    width: 232px;
    height: 54px;
    margin: -27px 0 0 -116px;
    box-sizing: border-box;
    padding: 0 14px 0 9px;
    border-radius: 17px;
    background: rgba(34, 24, 50, 0.94);
    border: 0.5px solid rgba(251, 244, 236, 0.2);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    will-change: transform, opacity;
  }
  .tile {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  .name {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .amount {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--leak);
  }
  .burst {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 60vmin;
    height: 60vmin;
    margin: -30vmin 0 0 -30vmin;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #fff6e8 0%,
      #ffc46b 22%,
      rgba(255, 107, 53, 0.4) 45%,
      transparent 70%
    );
    opacity: calc(
      clamp(0, (var(--k, 0) - 0.76) * 14, 1) * (1 - clamp(0, (var(--k, 0) - 0.82) * 9, 1))
    );
    transform: scale(calc(0.2 + clamp(0, (var(--k, 0) - 0.76) * 10, 1) * 1.2));
    pointer-events: none;
  }
  .counter {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    pointer-events: none;
    opacity: calc(
      1 - clamp(0, (var(--k, 0) - 0.62) * 12, 1) * 0.85 - clamp(0, (var(--k, 0) - 0.72) * 12, 1) *
        0.15
    );
  }
  .counter-label {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1vw, 13px);
    letter-spacing: 0.18em;
    color: var(--ink-70);
    padding: 0 20px;
  }
  .counter-number {
    font-size: min(15vw, 22vh);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 40px rgba(255, 90, 70, 0.35);
  }
  .stop {
    --on: clamp(0, (var(--k, 0) - 0.63) * 30, 1);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    font-size: min(34vw, 46vh);
    letter-spacing: -0.05em;
    line-height: 0.8;
    color: var(--ink);
    text-shadow:
      -5px 0 rgba(255, 40, 90, 0.75),
      5px 0 rgba(40, 220, 255, 0.75);
    opacity: calc(var(--on) * (1 - clamp(0, (var(--k, 0) - 0.74) * 14, 1)));
    transform: scale(calc(2.6 - 1.6 * var(--on)));
    filter: blur(calc((1 - var(--on)) * 14px));
  }
  .answer {
    --on: clamp(0, (var(--k, 0) - 0.85) * 8, 1);
    position: absolute;
    inset: 0;
    padding: 0 clamp(20px, 6vw, 88px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    opacity: var(--on);
    transform: translateY(calc((1 - var(--on)) * 30px));
  }
  .vi {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(18px, 1.8vw, 26px);
    color: var(--ink-60);
  }
  .answer .lede {
    max-width: 460px;
  }
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 9vh;
    background: #000;
  }
  .bar-top {
    top: 0;
  }
  .bar-bottom {
    bottom: 0;
  }
</style>
