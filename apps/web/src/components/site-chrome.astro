---
import { ruler } from '../data/story';

interface Props {
  /** "6pm 2.0 · Fri 6 Nov, 18:00": the dock's line until the visitor works out their leak. */
  dockLine: string;
  /** The sky clock before the page has scrolled. */
  clock: string;
}

const { dockLine, clock } = Astro.props;
---

<a href="#top" class="brand" data-brand aria-label="6pm 2.0, back to the top">
  <span class="brand-word">6pm</span>
  <span class="brand-tag">2.0</span>
</a>
<a href="#list" class="join">Join the list</a>

<a href="#list" class="dock" data-dock tabindex="-1" aria-hidden="true">
  <span class="dock-line" data-dock-line>{dockLine}</span>
  <span class="dock-cta">Join the list<span class="icon dock-arrow">arrow_forward</span></span>
</a>

<div class="ruler" aria-hidden="true">
  <div class="ruler-line"></div>
  {
    ruler.map((r) => (
      <div class="ruler-mark" style={`top:${r.top}`}>
        {r.label}
        <span />
      </div>
    ))
  }
  <div class="ruler-dot"></div>
  <div class="ruler-clock" data-clock>{clock}</div>
</div>

<style>
  .brand {
    position: fixed;
    z-index: 20;
    left: clamp(16px, 3vw, 36px);
    top: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--brand, var(--sun-ink));
    text-decoration: none;
    transition: color 0.4s;
  }
  .brand:hover {
    color: var(--brand, var(--sun-ink));
  }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .brand-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 4px 7px 3px;
    border: 1.5px solid currentColor;
    border-radius: 6px;
  }
  .join {
    position: fixed;
    z-index: 20;
    right: clamp(16px, 3vw, 36px);
    top: 14px;
    height: 42px;
    padding: 0 18px;
    border-radius: 99px;
    background: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    display: flex;
    align-items: center;
    box-shadow: 0 8px 24px rgba(20, 8, 30, 0.25);
  }
  .join:hover {
    color: var(--on-accent);
    filter: brightness(1.07);
  }
  .dock {
    position: fixed;
    z-index: 25;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    max-width: calc(100vw - 24px);
    box-sizing: border-box;
    transform: translate(-50%, 140%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.2, 0.9, 0.2, 1),
      opacity 0.4s;
    height: 56px;
    padding: 0 7px 0 20px;
    border-radius: 99px;
    background: rgba(18, 12, 28, 0.84);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 0.5px solid rgba(251, 244, 236, 0.2);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .dock[data-shown] {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }
  .dock:hover {
    color: var(--ink);
    filter: brightness(1.06);
  }
  .dock-line {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14.5px;
    font-weight: 600;
  }
  .dock-cta {
    flex-shrink: 0;
    height: 42px;
    padding: 0 18px;
    border-radius: 99px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 14.5px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dock-arrow {
    font-size: 18px;
  }
  .ruler {
    position: fixed;
    z-index: 20;
    right: clamp(10px, 1.6vw, 22px);
    top: 28vh;
    height: 44vh;
    width: 44px;
    mix-blend-mode: difference;
    color: #fff;
    pointer-events: none;
    font-family: var(--font-mono);
  }
  .ruler-line {
    position: absolute;
    right: 6px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: #fff;
    opacity: 0.5;
  }
  .ruler-mark {
    position: absolute;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }
  .ruler-mark span {
    width: 13px;
    height: 1.5px;
    background: #fff;
  }
  .ruler-dot,
  .ruler-clock {
    position: absolute;
    top: calc(var(--hourT) * 100%);
  }
  .ruler-dot {
    right: 1px;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: #fff;
  }
  .ruler-clock {
    right: 58px;
    transform: translateY(-50%);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
