---
import { CONTACT_TEL } from '../data/legal';
import DuskBuddy from './dusk-buddy.astro';
---

<footer class="footer">
  <div class="sign">
    <DuskBuddy size={44} mood="sleepy" />
    <div class="sign-text">
      <span class="word">6pm</span>
      <span class="line">Close your day at six.</span>
    </div>
  </div>
  <div class="links">
    <a href="#">Press kit</a>
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href={`tel:${CONTACT_TEL}`}>Contact</a>
    <span class="year">© 2026</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 36px clamp(20px, 6vw, 88px) 44px;
    box-sizing: border-box;
    border-top: 0.5px solid rgba(251, 244, 236, 0.14);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .sign {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sign-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.05em;
  }
  .line {
    font-size: 13px;
    color: var(--ink-70);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    font-size: 14px;
    font-weight: 600;
  }
  .links a {
    color: var(--ink-80);
    text-decoration: none;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-60);
  }
</style>
