---
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].beliefs;
const last = t.phrases.length - 1;
---

<section class="sec beliefs" data-hour="20.1">
  <p data-reveal="0">
    {
      t.phrases.map((phrase, i) => (
        <span class:list={{ last: i === last }} style={`animation-delay:${i * 2}s`}>
          {phrase}
        </span>
      ))
    }
  </p>
</section>

<style>
  p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.26em;
    font-family: var(--font-display);
    font-weight: 500;
    font-variation-settings:
      'opsz' 96,
      'wdth' 88;
    font-size: clamp(44px, 7vw, 112px);
    line-height: calc(1 + var(--hlx));
    letter-spacing: -0.05em;
  }
  /* Each phrase lights up in turn; the last one in the sunset colour. */
  span {
    color: rgba(251, 244, 236, 0.18);
    animation: lit 12s ease-in-out infinite;
  }
  span.last {
    color: rgba(255, 133, 82, 0.25);
    animation-name: litAccent;
  }
  /* Held still, every phrase stays lit. */
  @media (prefers-reduced-motion: reduce) {
    span {
      animation: none !important;
      color: #fbf4ec;
    }
    span.last {
      color: var(--sun);
    }
  }
  @keyframes lit {
    0%, 100% { color: rgba(251, 244, 236, 0.18); }
    5%, 22% { color: #fbf4ec; }
    32% { color: rgba(251, 244, 236, 0.18); }
  }
  @keyframes litAccent {
    0%, 100% { color: rgba(255, 133, 82, 0.25); }
    5%, 22% { color: #ff8552; }
    32% { color: rgba(255, 133, 82, 0.25); }
  }
</style>
