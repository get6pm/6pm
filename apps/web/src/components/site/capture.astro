---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import CapturePhone from './capture-phone.astro';
import Mark from './mark.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].capture;
---

<section id="capture" class="sec split" data-hour="12.7" data-capture>
  <div class="copy">
    <div class="stack" data-reveal="0">
      <Mark time="12:40" label={t.mark} />
      <h2 class="h2">{t.title}</h2>
      <p class="lede">{t.sub}</p>
    </div>
    <div class="ways" data-reveal="80">
      {
        t.ways.map(([label, line, icon], i) => (
          <button type="button" class="way" aria-pressed={i === 0 ? 'true' : 'false'} data-way={i}>
            <span class="way-tile">
              <span class="sym">{icon}</span>
            </span>
            <span class="way-words">
              <span class="way-label">{label}</span>
              <span class="way-line">{line}</span>
            </span>
            <span class="sym arrow" aria-hidden="true">
              arrow_forward
            </span>
          </button>
        ))
      }
    </div>
  </div>
  <CapturePhone lang={lang} />
</section>

<style>
  .copy {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-width: 0;
  }
  .ways {
    display: flex;
    flex-direction: column;
    border-top: 0.5px solid var(--line);
  }
  .way {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 10px 14px 10px 6px;
    border: none;
    border-bottom: 0.5px solid var(--line);
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.25s;
  }
  .way:hover,
  .way[aria-pressed='true'] {
    background: var(--glass);
  }
  .way-tile {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--glass);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s;
  }
  .way-tile .sym {
    font-size: 20px;
  }
  [aria-pressed='true'] .way-tile {
    background: var(--sun);
    color: var(--on-sun);
  }
  .way-words {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .way-label {
    font-size: 16.5px;
    font-weight: 600;
  }
  .way-line {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink2);
    opacity: 0.6;
    transition: opacity 0.25s;
  }
  [aria-pressed='true'] .way-line {
    opacity: 1;
  }
  .arrow {
    font-size: 20px;
    opacity: 0;
  }
  [aria-pressed='true'] .arrow {
    opacity: 1;
  }
</style>
