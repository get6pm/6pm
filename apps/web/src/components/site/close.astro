---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import Buddy from './buddy.astro';
import CloseCard from './close-card.astro';
import Mark from './mark.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].close;
---

<section id="close" class="sec close" data-hour="18" data-close>
  <div class="stack head" data-reveal="0">
    <Mark time="18:00" label={t.mark} accent />
    <h2 class="h2">{t.title}</h2>
    <p class="lede">{t.sub}</p>
  </div>

  <div class="play" data-reveal="80">
    <div class="deck">
      {
        t.cards.map((card, i) => (
          <CloseCard card={card} t={t} index={i} />
        ))
      }
      <div class="done" hidden data-close-done>
        <Buddy size={96} mood="happy" />
        <span class="mono done-label">{t.tomorrowLabel}</span>
        <span class="done-num">{t.tomorrow}</span>
        <span class="done-note">{t.tomorrowNote}</span>
      </div>
      <div class="stamp mono" hidden data-close-stamp aria-hidden="true">
        {t.closedStamp}<br />18:00
      </div>
    </div>

    <div class="controls">
      <div class="open" data-close-open>
        <button type="button" class="undo" aria-label={t.undo} disabled data-close-undo>
          <span class="sym" aria-hidden="true">undo</span>
        </button>
        <button
          type="button"
          class="keep"
          data-close-keep
          data-keep={t.keep}
          data-keep-last={t.keepLast}
        >
          <span class="sym" aria-hidden="true">check</span><span data-close-keep-label
            >{t.keep}</span
          >
        </button>
        <span class="step mono" data-close-step>1 / 3</span>
      </div>
      <button type="button" class="again" hidden data-close-again>
        <span class="sym" aria-hidden="true">replay</span>{t.again}
      </button>
    </div>
    <span class="hint">{t.hint}</span>
  </div>
</section>

<style>
  .close {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(36px, 4vw, 56px);
  }
  .head {
    align-items: center;
    max-width: 900px;
  }
  .head .h2 {
    --size: clamp(52px, 7.4vw, 116px);
    --lh: 0.88;
    --ls: -0.055em;
  }
  .head .lede {
    max-width: 520px;
  }
  .play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    width: 100%;
  }
  .deck {
    position: relative;
    width: min(320px, 86vw);
    height: 410px;
  }
  .done {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    animation: rise 0.6s 0.2s both;
  }
  .done[hidden],
  .stamp[hidden],
  .open[hidden],
  .again[hidden] {
    display: none;
  }
  .done-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--ink2);
  }
  .done-num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(64px, 9vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--sun);
  }
  .done-note {
    font-size: 15px;
    color: var(--ink2);
    max-width: 280px;
    text-wrap: balance;
  }
  .stamp {
    position: absolute;
    left: 50%;
    top: 16%;
    padding: 10px 18px 8px;
    border: 3.5px solid #ff8f7a;
    border-radius: 10px;
    color: #ff8f7a;
    font-weight: 600;
    font-size: 22px;
    letter-spacing: 0.16em;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
    animation: stampIn 0.55s cubic-bezier(0.3, 1.5, 0.5, 1) both;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(-8deg);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
  }
  .open {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .undo,
  .again {
    border: 0.5px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.2s,
      background 0.2s;
  }
  .undo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
  }
  .undo:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .undo:not(:disabled):hover,
  .again:hover {
    background: var(--glass);
  }
  .undo .sym {
    font-size: 22px;
  }
  .keep {
    height: 64px;
    padding: 0 30px 0 24px;
    border: none;
    border-radius: 99px;
    background: var(--sun);
    color: var(--on-sun);
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 14px 34px -10px rgba(255, 133, 82, 0.7);
    transition: background 0.2s;
  }
  .keep:hover {
    background: var(--sun-hover);
  }
  .keep .sym {
    font-size: 24px;
  }
  .step {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink2);
    min-width: 48px;
  }
  .again {
    height: 52px;
    padding: 0 22px 0 18px;
    border-radius: 99px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    gap: 8px;
  }
  .again .sym {
    font-size: 20px;
  }
  .hint {
    font-size: 13.5px;
    color: var(--ink2);
  }
  @keyframes stampIn {
    0% { opacity: 0; transform: translate(-50%, -50%) rotate(-16deg) scale(2.2); }
    60% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(0.94); }
    100% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(1); }
  }
</style>
