---
import { ctaMode } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';
import Buddy from './buddy.astro';
import JoinCta from './join-cta.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].final;
const hero = siteCopy[lang].hero;
const store = ctaMode === 'store';
---

<section id="join" class="final" data-hour="23.9">
  <div data-reveal="0"><Buddy size={88} mood="sleepy" /></div>
  <span class="mono kick" data-reveal="0" data-countdown={store ? undefined : ''}>
    {store ? t.storeKicker : hero.kickWait}
  </span>
  <h2 data-reveal="60">{t.a} <span class="accent">{t.b}</span></h2>
  <p data-reveal="90">{t.sub}</p>
  <div class="cta" data-reveal="120">
    <JoinCta lang={lang} size="final" />
  </div>
</section>

<style>
  .final {
    box-sizing: border-box;
    padding: clamp(100px, 13vw, 170px) var(--pad-x) clamp(110px, 14vw, 180px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }
  .kick {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink2);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-variation-settings:
      'opsz' 96,
      'wdth' 88;
    font-size: clamp(64px, 10.5vw, 170px);
    line-height: calc(0.86 + var(--hlx));
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .accent {
    color: var(--sun);
  }
  p {
    margin: 0;
    max-width: 440px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink2);
    text-wrap: balance;
  }
  .cta {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 6px;
  }
</style>
