---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import HeroSheet from './hero-sheet.astro';
import StatusBar from './status-bar.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].phone;
---

<div class="phone" aria-hidden="true">
  <div class="bezel tilt">
    <div class="screen">
      <div class="sun-glow"></div>
      <div class="sun-disc"></div>
      <StatusBar time="09:12" battery={80} />
      <div class="head">
        <div class="when">
          <span class="day">{t.day}</span><span class="date">{t.date}</span>
        </div>
        <div class="buttons">
          <span class="round"><span class="sym" style="font-size:19px">tune</span></span>
          <span class="round"><span class="sym" style="font-size:22px">add</span></span>
        </div>
      </div>
      <div class="number">
        <span class="safe">{t.safe}</span>
        <span class="big" style={`font-size:${t.numSize}`}>{t.num}</span>
        <div class="progress">
          <div class="track"><div class="fill"></div></div>
          <div class="ends"><span>{t.spent}</span><span>{t.of}</span></div>
        </div>
      </div>
      <HeroSheet lang={lang} />
    </div>
  </div>
</div>

<style>
  .tilt {
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.3),
      0 50px 100px -30px rgba(30, 40, 40, 0.55);
    transform: rotate(-2deg);
  }
  .screen {
    background: linear-gradient(180deg, #8fd0c6 0%, #e4efcf 52%, #fff1cf 100%);
    color: #1b1e2e;
  }
  .sun-glow {
    position: absolute;
    right: -150px;
    top: -50px;
    width: 390px;
    height: 390px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 246, 200, 0.55), rgba(255, 230, 140, 0.18) 45%, transparent);
  }
  .sun-disc {
    position: absolute;
    right: -30px;
    top: 70px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: radial-gradient(circle, #fffdf4 0%, #fff6dc 32%, #fff3b0 72%, #ffe08a 100%);
    filter: blur(2px);
    box-shadow: 0 0 24px 6px rgba(255, 240, 170, 0.7);
  }
  .head {
    position: relative;
    padding: 12px 18px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .when {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .day {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(27, 30, 46, 0.7);
  }
  .date {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .buttons {
    display: flex;
    gap: 6px;
  }
  .round {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: inset 0 1px 0 #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .number {
    position: relative;
    padding: 58px 18px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .safe {
    font-size: 13px;
    font-weight: 500;
    color: rgba(27, 30, 46, 0.72);
  }
  .big {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-left: -2px;
  }
  .progress {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    max-width: 220px;
  }
  .track {
    height: 5px;
    border-radius: 5px;
    background: rgba(27, 30, 46, 0.12);
    overflow: hidden;
  }
  .fill {
    width: 9%;
    height: 100%;
    border-radius: 5px;
    background: #1b1e2e;
  }
  .ends {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(27, 30, 46, 0.72);
  }
</style>
