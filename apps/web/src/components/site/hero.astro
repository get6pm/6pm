---
import { ctaMode } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';
import HeroPhone from './hero-phone.astro';
import JoinCta from './join-cta.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].hero;
---

<section id="top" class="hero" data-hour="9">
  <div class="copy">
    <div class="kicker mono">
      <span class="dot"></span><span>{ctaMode === 'store' ? t.kickStore : t.kickWait}</span>
    </div>
    <h1>{t.a} <span class="accent">{t.b}</span></h1>
    <p class="sub">{t.sub}</p>
    <JoinCta lang={lang} size="hero" />
    <div class="clock mono">
      <span class="sym" aria-hidden="true">schedule</span><span data-clock-line></span>
    </div>
  </div>
  <HeroPhone lang={lang} />
</section>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    box-sizing: border-box;
    min-height: 100vh;
    padding: clamp(110px, 14vh, 150px) var(--pad-x) clamp(60px, 8vh, 96px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink2);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sun);
    animation: pulse 2.4s ease-in-out infinite;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-variation-settings:
      'opsz' 96,
      'wdth' 88;
    font-size: clamp(64px, 9.4vw, 148px);
    line-height: calc(0.86 + var(--hlx));
    letter-spacing: -0.06em;
    text-wrap: balance;
  }
  .accent {
    color: var(--acc);
  }
  .sub {
    margin: 0;
    max-width: 470px;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    color: var(--ink2);
    text-wrap: pretty;
  }
  .clock {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 16px;
    font-size: 12px;
    color: var(--ink2);
  }
  .clock .sym {
    font-size: 16px;
  }
</style>
