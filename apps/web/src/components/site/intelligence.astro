---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import AskCard from './ask-card.astro';
import ReceiptCard from './receipt-card.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].ai;
---

<section id="intelligence" class="band">
  <div class="wrap ai">
    <div class="head" data-reveal="0">
      <div class="stack titles">
        <span class="kicker">{t.kicker}</span>
        <h2 class="display">{t.title}</h2>
      </div>
      <p class="sub">{t.sub}</p>
    </div>
    <div class="cards">
      <AskCard lang={lang} />
      <ReceiptCard lang={lang} />
    </div>
  </div>
</section>

<style>
  .ai {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 64px;
  }
  .titles {
    gap: 18px;
  }
  .sub {
    max-width: 340px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
  }
  /* The two cards share their frame. */
  .cards :global(.card) {
    position: relative;
    min-height: 380px;
    border-radius: 32px;
    background: var(--card);
    border: 0.5px solid var(--line);
    padding: 28px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .cards :global(.card-label) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-55);
  }
  .cards :global(.card-label .sym) {
    font-size: 16px;
    color: var(--sun-soft);
  }
</style>
