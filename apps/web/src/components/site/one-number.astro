---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import Mark from './mark.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].number;
---

<section class="sec number" data-hour="19.4">
  <div class="stack head" data-reveal="0">
    <Mark time="19:30" label={t.mark} />
    <h2 class="h2">{t.title}</h2>
  </div>
  <div class="body">
    <div class="sum" data-reveal="60">
      {
        t.rows.map(([op, label, value]) => (
          <div class="row">
            <span class="op mono">{op}</span>
            <span class="label">{label}</span>
            <span class="value mono">{value}</span>
          </div>
        ))
      }
    </div>
    <div class="result" data-reveal="140">
      <span class="result-label mono">{t.label}</span>
      <span class="result-line"
        ><span class="big" style={`font-size:${t.size}`}>{t.num}</span><span class="per"
          >{t.perDay}</span
        ></span
      >
      <p>{t.sub}</p>
    </div>
  </div>
</section>

<style>
  .number {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head {
    max-width: 900px;
  }
  .head .h2 {
    --size: clamp(40px, 5vw, 76px);
    --lh: 0.94;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    align-items: end;
    gap: clamp(32px, 6vw, 96px);
  }
  .sum {
    display: flex;
    flex-direction: column;
    font-variant-numeric: tabular-nums;
  }
  .row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 0.5px solid var(--line);
  }
  .op {
    font-size: 14px;
    color: var(--sun);
  }
  .label {
    font-size: 16px;
    color: var(--ink2);
  }
  .value {
    font-size: 16px;
    font-weight: 500;
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .result-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--ink2);
  }
  .result-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .big {
    font-family: var(--font-display);
    font-weight: 500;
    font-variation-settings:
      'opsz' 96,
      'wdth' 88;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--sun);
  }
  .per {
    font-size: 20px;
    color: var(--ink2);
  }
  p {
    margin: 8px 0 0;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink2);
    text-wrap: pretty;
  }
</style>
