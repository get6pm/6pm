---
import { repoUrl } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].openSource;
// A few of the folders the clone brings down, each with what it holds.
const cloned = [
  ['apps/mobile', '· the iPhone app'],
  ['packages/domain', '· every money rule, tested'],
  ['legal/privacy', '· what we promise'],
] as const;
---

<section id="opensource" class="band">
  <div class="wrap split">
    <div class="stack" data-reveal="0">
      <span class="kicker">{t.kicker}</span>
      <h2 class="display">{t.title}</h2>
      <p class="sub">{t.sub}</p>
      <a class="repo" href={repoUrl} target="_blank" rel="noopener">
        <span class="sym" aria-hidden="true">code</span>get6pm/6pm<span
          class="sym small"
          aria-hidden="true">arrow_outward</span
        >
      </a>
    </div>
    <div class="term" data-reveal="100" aria-hidden="true">
      <div class="chrome">
        <span class="light"></span><span class="light"></span><span class="light"></span>
        <span class="mono path">~/code</span>
      </div>
      <div class="mono body">
        <div class="cmd">
          <span class="prompt">$</span><span class="typed">git clone github.com/get6pm/6pm</span
          ><span class="caret"></span>
        </div>
        <div class="out">
          <span>Cloning into '6pm'…</span>
          {
            cloned.map(([path, note]) => (
              <span>
                <span class="ok">✓</span> {path} <span class="faint">{note}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sub {
    max-width: 420px;
  }
  .repo {
    align-self: flex-start;
    height: 50px;
    margin-top: 6px;
    padding: 0 22px 0 18px;
    border-radius: 99px;
    border: 0.5px solid rgba(243, 238, 231, 0.3);
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .repo:hover {
    background: var(--ink);
    color: var(--dark-ink);
  }
  .repo .sym {
    font-size: 20px;
  }
  .repo .small {
    font-size: 18px;
  }
  .term {
    min-width: 0;
    border-radius: 24px;
    background: var(--card);
    border: 0.5px solid rgba(243, 238, 231, 0.1);
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .chrome {
    height: 44px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 0.5px solid var(--line);
  }
  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-3);
  }
  .path {
    flex: 1;
    text-align: center;
    font-size: 11px;
    color: var(--ink-45);
    margin-right: 50px;
  }
  .body {
    padding: 24px 22px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: clamp(12px, 1.2vw, 14px);
    line-height: 1.5;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .prompt {
    color: var(--sun);
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    animation: type 7s steps(30) infinite both;
  }
  .caret {
    width: 8px;
    height: 1.2em;
    background: var(--ink);
    animation: blink 1s steps(1) infinite;
  }
  .out {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: rgba(243, 238, 231, 0.6);
    animation: lineIn 7s infinite both;
  }
  .ok {
    color: var(--mint);
  }
  .faint {
    color: rgba(243, 238, 231, 0.35);
  }

  @keyframes type {
    0% { width: 0; }
    40%, 88% { width: 30ch; }
    96%, 100% { width: 0; }
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes lineIn {
    0%, 44% { opacity: 0; transform: translateY(6px); }
    50%, 88% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0; transform: none; }
  }
</style>
