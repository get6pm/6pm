---
import { repoUrl } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';
import Mark from './mark.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].privacy;
const icons = ['phonelink_lock', 'no_accounts', 'code'];
---

<section id="privacy" class="sec privacy" data-hour="22">
  <div class="stack" data-reveal="0">
    <Mark time="22:00" label={t.mark} />
    <h2 class="h2">{t.title}</h2>
  </div>
  <div class="facts">
    {
      t.facts.map(([title, line], i) => (
        <div class="fact" data-reveal={String(i * 80)}>
          <span class="sym" aria-hidden="true">
            {icons[i]}
          </span>
          <span class="fact-title">{title}</span>
          <span class="fact-line">{line}</span>
        </div>
      ))
    }
  </div>
  <div class="terminal" data-reveal="80">
    <div class="chrome">
      <span class="light"></span><span class="light"></span><span class="light"></span>
      <span class="grow"></span>
      <a class="repo mono" href={repoUrl} target="_blank" rel="noopener"
        >get6pm/6pm<span class="sym" aria-hidden="true">arrow_outward</span></a
      >
    </div>
    <div class="lines mono">
      <div class="prompt">
        <span class="dollar">$</span><span class="typed">git clone github.com/get6pm/6pm</span><span
          class="caret moving"></span>
      </div>
      <div class="out">
        <span>{t.cloning}</span>
        <span><span class="ok">✓</span> apps/mobile <span class="dim">· {t.app}</span></span>
        <span><span class="ok">✓</span> packages/domain <span class="dim">· {t.domain}</span></span>
        <span><span class="ok">✓</span> legal/privacy <span class="dim">· {t.legal}</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .h2 {
    max-width: 1000px;
    --size: clamp(48px, 7vw, 112px);
    --lh: 0.88;
    --ls: -0.055em;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    border-top: 0.5px solid var(--line);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 28px 28px 0;
  }
  .fact .sym {
    font-size: 28px;
    color: var(--sun-soft);
  }
  .fact-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .fact-line {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink2);
    text-wrap: pretty;
  }
  .terminal {
    border-radius: 24px;
    background: rgba(10, 8, 18, 0.55);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: #fbf4ec;
  }
  .chrome {
    height: 44px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
  }
  .light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .grow {
    flex: 1;
  }
  .repo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: rgba(251, 244, 236, 0.7);
    text-decoration: none;
  }
  .repo:hover {
    color: var(--sun-soft);
  }
  .repo .sym {
    font-size: 15px;
  }
  .lines {
    padding: 24px 22px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: clamp(12px, 1.2vw, 14px);
    line-height: 1.5;
    overflow: hidden;
  }
  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .dollar {
    color: var(--sun);
  }
  .typed {
    --w: 30ch;
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    animation: type 7s steps(30) infinite both;
  }
  .caret {
    width: 8px;
    height: 1.2em;
    background: #fbf4ec;
    animation: blink 1s steps(1) infinite;
  }
  .out {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: rgba(251, 244, 236, 0.62);
    animation: lineIn 7s infinite both;
  }
  .ok {
    color: #a8dcb8;
  }
  .dim {
    color: rgba(251, 244, 236, 0.38);
  }
  /* Held still, the clone has finished. */
  @media (prefers-reduced-motion: reduce) {
    .typed,
    .out {
      animation: none !important;
    }
  }
  @keyframes type {
    0% { width: 0; }
    40%, 88% { width: var(--w); }
    96%, 100% { width: 0; }
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  @keyframes lineIn {
    0%, 44% { opacity: 0; transform: translateY(6px); }
    50%, 88% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0; transform: none; }
  }
</style>
