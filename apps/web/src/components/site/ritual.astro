---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import { glyphColor, tileGradient } from '../../data/site/tiles';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].ritual;
const hours = ['08', '10', '12', '14', '16', '18'].map((h, i) => ({
  label: `${h}:00`,
  x: `${4 + i * 16.8}%`,
  six: i === 5,
}));
// Where each of the day's spends pops up on the timeline: icon, tile hue, x, y.
const chips = (
  [
    ['local_cafe', 25, '14%', '36%'],
    ['two_wheeler', 220, '27%', '20%'],
    ['ramen_dining', 60, '41%', '38%'],
    ['shopping_bag', 300, '56%', '18%'],
    ['storefront', 150, '71%', '36%'],
  ] as const
).map(([icon, hue, x, y], i) => ({ icon, hue, x, y, amount: t.dayAmounts[i] ?? '' }));
---

<section id="ritual" class="wrap ritual">
  <div class="stack head" data-reveal="0">
    <span class="kicker">{t.kicker}</span>
    <h2 class="display">{t.title}</h2>
  </div>
  <div class="day" data-reveal="80" aria-hidden="true">
    <div class="axis"></div>
    {
      hours.map((h) => (
        <div class="hour" style={`left:${h.x}`}>
          <span class="tick" />
          <span class:list={['mono', { six: h.six }]}>{h.label}</span>
        </div>
      ))
    }
    <div class="chips">
      {
        chips.map((c) => (
          <div class="chip" style={`--x:${c.x};--y:${c.y}`}>
            <span class="tile" style={`background:${tileGradient(c.hue)};color:${glyphColor(c.hue)}`}>
              <span class="sym sym-fill">{c.icon}</span>
            </span>
            <span class="mono">−{c.amount}</span>
          </div>
        ))
      }
    </div>
    <div class="playhead moving"></div>
    <div class="sun-dot"></div>
    <div class="tomorrow">
      <span class="mono">{t.tomorrow}</span>
      <span class="num">{t.num}</span>
    </div>
  </div>
  <div class="caps">
    {
      t.caps.map(([time, text], i) => (
        <div class="cap" data-reveal={i * 90}>
          <span class:list={['mono', { six: i === 1 }]}>{time}</span>
          <span class="cap-text">{text}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ritual {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head {
    gap: 18px;
  }
  .day {
    position: relative;
    height: clamp(260px, 30vw, 340px);
    border-radius: 32px;
    background: #110f14;
    border: 0.5px solid var(--line);
    overflow: hidden;
  }
  .axis {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 62%;
    height: 1px;
    background: var(--line-3);
  }
  .hour {
    position: absolute;
    top: 62%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: var(--ink-45);
  }
  .tick {
    width: 1px;
    height: 8px;
    background: rgba(243, 238, 231, 0.3);
  }
  .six {
    color: var(--sun);
  }
  .chips {
    position: absolute;
    inset: 0;
    animation: reveal 9s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 14px;
    background: #1c1a20;
    border: 0.5px solid rgba(243, 238, 231, 0.1);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    font-size: 11.5px;
    animation: chipGo 9s cubic-bezier(0.5, 0, 0.3, 1) infinite;
  }
  .tile {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tile .sym {
    font-size: 15px;
  }
  .playhead {
    position: absolute;
    left: 4%;
    top: 14%;
    bottom: 30%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(243, 238, 231, 0.5));
    animation: play 9s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .sun-dot {
    position: absolute;
    left: 88%;
    top: 62%;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sun);
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 0 6px rgba(255, 133, 82, 0.12),
      0 0 20px rgba(255, 133, 82, 0.5);
    animation: sunHit 9s infinite;
  }
  .tomorrow {
    position: absolute;
    right: 4%;
    top: 12%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    animation: numIn 9s infinite both;
  }
  .tomorrow .mono {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(243, 238, 231, 0.6);
  }
  .num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--sun);
  }
  .caps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 24px;
  }
  .cap {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .cap .mono {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-55);
    min-width: 72px;
  }
  .cap .six {
    color: var(--sun);
  }
  .cap-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  @keyframes play {
    0% { left: 4%; opacity: 0; }
    4% { opacity: 1; }
    60%, 90% { left: 88%; opacity: 1; }
    96%, 100% { left: 88%; opacity: 0; }
  }
  @keyframes reveal {
    0% { clip-path: inset(-40% 96% -40% 0); }
    60%, 100% { clip-path: inset(-40% 12% -40% 0); }
  }
  @keyframes chipGo {
    0%, 64% { left: var(--x); top: var(--y); opacity: 1; transform: translate(-50%, -50%) scale(1); }
    76%, 100% { left: 88%; top: 62%; opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
  }
  @keyframes sunHit {
    0%, 60% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 0 0 6px rgba(255, 133, 82, 0.12), 0 0 20px rgba(255, 133, 82, 0.5);
    }
    68% {
      transform: translate(-50%, -50%) scale(1.7);
      box-shadow: 0 0 0 18px rgba(255, 133, 82, 0.14), 0 0 60px rgba(255, 133, 82, 0.9);
    }
    80%, 100% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 0 0 6px rgba(255, 133, 82, 0.12), 0 0 20px rgba(255, 133, 82, 0.5);
    }
  }
  @keyframes numIn {
    0%, 72% { opacity: 0; transform: translateY(14px); }
    78%, 92% { opacity: 1; transform: none; }
    98%, 100% { opacity: 0; transform: none; }
  }
</style>
