---
import { legalPath } from '../../data/legal';
import { repoUrl, studioUrl } from '../../data/site/config';
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].foot;
---

<footer class="footer">
  <div class="foot">
    <div class="sign">
      <span class="word">6pm</span>
      <span class="tag">{t.tag}</span>
    </div>
    <div class="links">
      <a class="os" href={repoUrl} target="_blank" rel="noopener">
        <span class="sym" aria-hidden="true">code</span>{t.openSource}
      </a>
      <a href={legalPath(lang, 'privacy')}>{t.privacy}</a>
      <a href={legalPath(lang, 'terms')}>{t.terms}</a>
      <span class="mono credit">
        © 2026 · {t.madeBy}{' '}
        <a href={studioUrl} target="_blank" rel="noopener">oddeggs.studio</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 0.5px solid var(--line);
  }
  .foot {
    max-width: 1240px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 36px var(--pad-x) 44px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .sign {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.05em;
  }
  .tag {
    font-size: 14px;
    color: var(--ink2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    font-size: 14px;
  }
  .links > a {
    color: var(--ink2);
    text-decoration: none;
  }
  .links > a:hover {
    color: var(--sun-soft);
  }
  .os {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .os .sym {
    font-size: 17px;
  }
  .credit {
    font-size: 12px;
    color: var(--ink2);
  }
  .credit a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s;
  }
  .credit a:hover {
    color: var(--sun-soft);
  }
</style>
