---
import { appStoreUrl, ctaMode } from '../../data/site/config';
import { homePath, siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].nav;
const store = ctaMode === 'store';
---

<header class="nav">
  <div class="bar">
    <a class="brand" href="#top">6pm</a>
    <span class="clock mono" aria-hidden="true"><span class="dot"></span><span data-nav-clock
        >09:00</span
      ></span
    >
    <nav class="links" aria-label="6pm">
      <a href="#capture">{t.capture}</a>
      <a href="#close">{t.close}</a>
      <a href="#surfaces">{t.surfaces}</a>
      <a href="#duo">iPhone Duo</a>
      <a href="#privacy">{t.privacy}</a>
      <a href="#pricing">{t.pricing}</a>
    </nav>
    <div class="langs mono" role="group" aria-label={t.langLabel}>
      {
        (['en', 'vi'] as const).map((code) => (
          <a
            href={homePath[code]}
            hreflang={code}
            lang={code}
            data-lang-pick={code}
            aria-current={code === lang ? 'true' : undefined}
          >
            {code.toUpperCase()}
          </a>
        ))
      }
    </div>
    <a class="cta" href={store ? appStoreUrl : '#join'}>{store ? t.store : t.wait}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    background: var(--nav);
    backdrop-filter: saturate(1.4) blur(20px);
    border-bottom: 0.5px solid var(--line);
  }
  .bar {
    max-width: 1240px;
    margin: 0 auto;
    height: 64px;
    box-sizing: border-box;
    padding: 0 var(--pad-x);
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
  }
  .brand {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .clock {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink2);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sun);
  }
  /* Links that do not fit wrap onto a hidden second row, so narrow screens keep only what fits. */
  .links {
    flex: 1;
    min-width: 0;
    height: 20px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 26px;
    font-size: 14px;
    line-height: 20px;
  }
  .links a {
    color: var(--ink2);
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover {
    color: var(--sun);
  }
  .langs {
    display: flex;
    padding: 3px;
    border-radius: 99px;
    border: 0.5px solid var(--line);
    font-size: 11.5px;
    letter-spacing: 0.06em;
  }
  .langs a {
    height: 28px;
    min-width: 36px;
    box-sizing: border-box;
    padding: 0 8px;
    border-radius: 99px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--ink2);
  }
  .langs a[aria-current] {
    background: var(--ink);
    color: var(--inv);
  }
  .cta {
    flex-shrink: 0;
    height: 36px;
    padding: 0 16px;
    border-radius: 99px;
    background: var(--sun);
    color: var(--on-sun);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .cta:hover {
    background: var(--sun-hover);
    color: var(--on-sun);
  }
  /* On a phone the bar keeps the brand, the clock, the language and the call to action; on the
     narrowest phones the clock steps aside so the call to action fits. */
  @media (max-width: 720px) {
    .links {
      visibility: hidden;
    }
  }
  @media (max-width: 420px) {
    .clock {
      display: none;
    }
  }
</style>
