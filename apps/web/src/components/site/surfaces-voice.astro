---
import type { SurfacesCopy } from '../../data/site/surfaces-copy';
import Buddy from './buddy.astro';

interface Props {
  t: SurfacesCopy;
}

const { t } = Astro.props;
---

<div class="column">
  <div class="panel siri-card" data-reveal="160">
    <span class="panel-label">SIRI</span>
    <div class="said">{t.siri.said}</div>
    <div class="reply" aria-hidden="true">
      <Buddy size={40} mood="happy" />
      <div class="words">
        <span class="logged">{t.siri.logged}</span><span class="after">{t.siri.after}</span>
      </div>
      <span class="amount">{t.siri.amount}</span>
    </div>
  </div>
  <div class="panel action-card" data-reveal="200">
    <span class="panel-label">{t.action.label}</span>
    <div class="row" aria-hidden="true">
      <span class="control"
        ><span class="circle sun"><span class="sym">{t.action.icon}</span></span><span class="name"
          >{t.action.first}</span
        ></span
      >
      <span class="control"
        ><span class="circle"><span class="sym">add</span></span><span class="name"
          >{t.action.second}</span
        ></span
      >
      <span class="button"
        ><span class="bar"></span><span class="button-words"
          ><span class="button-label">{t.action.buttonLabel}</span><span class="button-main"
            >{t.action.buttonMain}</span
          ></span
        ></span
      >
    </div>
    <span class="panel-note">{t.action.note}</span>
  </div>
</div>

<style>
  .column > .panel.siri-card {
    gap: 14px;
    background: linear-gradient(170deg, #3a2f6a 0%, #7a3f72 100%);
  }
  .said {
    align-self: flex-end;
    max-width: 90%;
    padding: 10px 16px;
    border-radius: 20px 20px 4px 20px;
    background: rgba(255, 255, 255, 0.14);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.25;
  }
  .reply {
    border-radius: 24px;
    background: #fbf4ec;
    color: #2a1d30;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .words {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .logged {
    font-size: 14px;
    font-weight: 650;
  }
  .after {
    font-size: 12px;
    opacity: 0.6;
  }
  .amount {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
  }
  .action-card {
    flex: 1;
    background: #16131c;
  }
  .row {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .control {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }
  .circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .circle.sun {
    background: var(--sun);
    color: var(--on-sun);
  }
  .circle .sym {
    font-size: 28px;
  }
  .name {
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
  }
  .button {
    flex: 1;
    min-width: 0;
    height: 64px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    box-sizing: border-box;
  }
  .bar {
    width: 6px;
    height: 32px;
    border-radius: 4px;
    background: var(--sun);
    flex-shrink: 0;
  }
  .button-words {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .button-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
  }
  .button-main {
    font-size: 13.5px;
    font-weight: 650;
  }
</style>
