---
import { siteCopy, type SiteLang } from '../../data/site/copy';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].together;
---

<section class="band band-dim">
  <div class="wrap split">
    <div class="stack" data-reveal="0">
      <span class="kicker">{t.kicker}</span>
      <h2 class="display">{t.title}</h2>
      <p class="sub">{t.sub}</p>
    </div>
    <div class="scene" data-reveal="100" aria-hidden="true">
      <div class="person left">
        <span class="avatar you">{t.youInitial}</span><span class="mono">{t.you}</span>
      </div>
      <div class="person right">
        <span class="avatar partner">{t.partnerInitial}</span><span class="mono">{t.partner}</span>
      </div>
      <div class="coin-x moving" style="--from:calc(var(--W) * -0.38)">
        <div class="coin you-coin"></div>
      </div>
      <div class="coin-x late moving" style="--from:calc(var(--W) * 0.38)">
        <div class="coin partner-coin"></div>
      </div>
      <div class="jar">
        <div class="lid"></div>
        <div class="glass">
          <div class="level"></div>
          <div class="shine"></div>
          <div class="mono jar-name">{t.jar}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sub {
    max-width: 400px;
  }
  .scene {
    --W: min(440px, 90vw);
    position: relative;
    justify-self: center;
    width: var(--W);
    height: 380px;
  }
  .person {
    position: absolute;
    top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .person .mono {
    font-size: 11px;
    color: rgba(243, 238, 231, 0.6);
  }
  .left {
    left: 4%;
  }
  .right {
    right: 4%;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-weight: 600;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: bob 3s ease-in-out infinite;
  }
  .avatar.you {
    background: var(--sun);
    color: var(--on-sun);
  }
  .avatar.partner {
    background: var(--lilac);
    color: #1f1830;
    animation-delay: 1.5s;
  }
  /* Each coin is thrown across (x) while it arcs up and drops in (y). */
  .coin-x {
    position: absolute;
    left: 50%;
    top: 52px;
    margin-left: -11px;
    animation: coinX 3s linear infinite both;
  }
  .coin {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    animation: coinY 3s infinite both;
  }
  .late,
  .late .coin {
    animation-delay: 1.5s;
  }
  .you-coin {
    background: radial-gradient(circle at 35% 30%, #ffe2bf, #ff8552 70%);
    box-shadow: inset 0 0 0 2px rgba(26, 15, 10, 0.15);
  }
  .partner-coin {
    background: radial-gradient(circle at 35% 30%, #f1eaff, #c9b8f0 70%);
    box-shadow: inset 0 0 0 2px rgba(31, 24, 48, 0.15);
  }
  .jar {
    position: absolute;
    left: 50%;
    bottom: 20px;
    width: 170px;
    height: 200px;
    margin-left: -85px;
  }
  .lid {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 0;
    height: 14px;
    border-radius: 6px;
    background: #1e1b22;
    border: 1px solid rgba(243, 238, 231, 0.24);
  }
  .glass {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    bottom: 0;
    box-sizing: border-box;
    border-radius: 30px 30px 44px 44px;
    border: 1px solid rgba(243, 238, 231, 0.24);
    background: rgba(243, 238, 231, 0.03);
    overflow: hidden;
  }
  .level {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background: linear-gradient(180deg, #ffb08a, #ff8552 40%, #c9b8f0);
    opacity: 0.85;
    animation: jar 12s cubic-bezier(0.4, 0, 0.6, 1) infinite both;
  }
  .shine {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 10px;
    bottom: 30px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
  }
  .jar-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 44%;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink);
    mix-blend-mode: difference;
  }

  @keyframes coinX {
    0% { transform: translateX(var(--from)); opacity: 0; }
    6% { opacity: 1; }
    45% { transform: translateX(0); opacity: 1; }
    48%, 100% { transform: translateX(0); opacity: 0; }
  }
  @keyframes coinY {
    0% { transform: translateY(0); animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1); }
    20% { transform: translateY(-60px); animation-timing-function: cubic-bezier(0.6, 0, 0.9, 0.5); }
    45%, 100% { transform: translateY(150px); }
  }
  @keyframes jar {
    0% { height: 16%; }
    88% { height: 76%; }
    94% { height: 76%; }
    100% { height: 16%; }
  }
</style>
