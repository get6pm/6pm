---
import { siteCopy, type SiteLang } from '../../data/site/copy';
import { glyphColor, tileGradient } from '../../data/site/tiles';
import Mark from './mark.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const t = siteCopy[lang].together;
---

<section class="sec split together" data-hour="22.6">
  <div class="stack" data-reveal="0">
    <Mark time="22:40" label={t.mark} />
    <h2 class="h2">{t.title}</h2>
    <p class="lede">{t.sub}</p>
  </div>
  <div class="pot" data-reveal="100">
    <div class="pot-head">
      <span class="tile" style={`--tile:${tileGradient(300)};--glyph:${glyphColor(300)}`}>
        <span class="sym sym-fill" aria-hidden="true">flight</span>
      </span>
      <span class="pot-words"><span class="jar">{t.jar}</span><span class="muted">{t.potSub}</span></span>
      <span class="faces" aria-hidden="true">
        <span class="face you">{t.youInitial}</span><span class="face them">{t.partnerInitial}</span>
      </span>
    </div>
    <div class="progress">
      <div class="track"><span class="mine"></span><span class="theirs"></span></div>
      <div class="ends"><span>{t.have}</span><span class="muted">{t.goal}</span></div>
    </div>
    <div class="who">
      <div class="line">
        <span class="name"><span class="dot you"></span>{t.you}</span><span class="sum"
          >{t.fromYou}</span
        >
      </div>
      <div class="line">
        <span class="name"><span class="dot them"></span>{t.partner}</span><span class="sum"
          >{t.fromPartner}</span
        >
      </div>
    </div>
    <span class="note muted">{t.note}</span>
  </div>
</section>

<style>
  .together {
    padding-top: clamp(60px, 8vw, 110px);
    padding-bottom: clamp(60px, 8vw, 110px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
  }
  .h2 {
    --size: clamp(40px, 5vw, 76px);
    --lh: 0.94;
  }
  .lede {
    max-width: 400px;
  }
  .pot {
    justify-self: center;
    width: min(400px, 100%);
    box-sizing: border-box;
    border-radius: 30px;
    background: #f6f0e7;
    color: #1b1e2e;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .pot-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tile {
    width: 46px;
    height: 46px;
    border-radius: 16px;
  }
  .tile .sym {
    font-size: 24px;
  }
  .pot-words {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .jar {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .muted {
    font-size: 13px;
    color: rgba(27, 30, 46, 0.62);
  }
  .faces {
    display: flex;
  }
  .face {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px #f6f0e7;
  }
  .face.you {
    background: var(--sun);
    color: var(--on-sun);
  }
  .face.them {
    margin-left: -8px;
    background: #c9b8f0;
    color: #1f1830;
  }
  .progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .track {
    display: flex;
    height: 10px;
    border-radius: 10px;
    background: rgba(27, 30, 46, 0.08);
    overflow: hidden;
  }
  .mine {
    width: 22%;
    background: var(--sun);
  }
  .theirs {
    width: 19%;
    background: #c9b8f0;
  }
  .ends {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .ends .muted {
    font-size: 13.5px;
  }
  .who {
    border-radius: 20px;
    background: #fffdf9;
    padding: 4px 14px;
  }
  .line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    font-size: 14px;
  }
  .line + .line {
    border-top: 0.5px solid rgba(27, 30, 46, 0.08);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .dot.you {
    background: var(--sun);
  }
  .dot.them {
    background: #c9b8f0;
  }
  .sum {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .note {
    font-size: 12.5px;
    line-height: 1.45;
  }
</style>
