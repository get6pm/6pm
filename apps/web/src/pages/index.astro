---
import CloseDemo from '../components/close-demo.astro';
import CompanionScene from '../components/companion-scene.astro';
import CreditsScene from '../components/credits-scene.astro';
import DialScene from '../components/dial-scene.astro';
import DiaryScene from '../components/diary-scene.astro';
import HeroScene from '../components/hero-scene.astro';
import LeakCalculator from '../components/leak-calculator.astro';
import LeakScene from '../components/leak-scene.astro';
import OdoScene from '../components/odo-scene.astro';
import SiteChrome from '../components/site-chrome.astro';
import SiteFooter from '../components/site-footer.astro';
import SkyBackdrop from '../components/sky-backdrop.astro';
import TitleScene from '../components/title-scene.astro';
import WaitlistScene from '../components/waitlist-scene.astro';
import { launchLabel } from '../data/launch';
import { clockAt, skyVariables } from '../data/sky';
import PageLayout from '../layouts/page-layout.astro';

const launch = launchLabel();
const launchUpper = launch.toUpperCase();
// The sky as it stands at the top of the page (17:00), so the first paint needs no script.
const sky = skyVariables(17)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');
const clock = clockAt(17);
---

<PageLayout
  title="6pm 2.0: close your day at six"
  description={`6pm catches every spend and gives you one number: safe to spend today. Version 2.0 arrives on iPhone ${launch}. Join the list.`}
>
  <div class="page" style={sky} data-page>
    <SkyBackdrop />
    <SiteChrome dockLine={`6pm 2.0 · ${launch}`} clock={clock} />
    <main>
      <HeroScene launchUpper={launchUpper} clock={clock} />
      <TitleScene />
      <LeakScene />
      <LeakCalculator />
      <DialScene />
      <CloseDemo />
      <OdoScene />
      <DiaryScene />
      <CompanionScene />
      <CreditsScene launchUpper={launchUpper} />
      <WaitlistScene launchUpper={launchUpper} />
    </main>
    <SiteFooter />
  </div>
</PageLayout>

<script>
  import { startPage } from '../scripts/start-page';

  startPage();
</script>

<style>
  .page {
    position: relative;
    color: var(--ink);
    font-family: var(--font-text);
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.01em;
    overflow-x: clip;
  }
</style>
