// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../.generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryEmail      String            @unique
  firstName         String?
  lastName          String?
  profilePictureUrl String?
  spaceMemberships  SpaceMembership[]
  metadata          UserMetadata[]
}

model UserMetadata {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  key    String
  value  String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

model Space {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name             String
  baseCurrencyCode String @default("USD")

  spaceMemberships SpaceMembership[]
  categories       SpendingCategory[]
  categoryGroups   SpendingCategoryGroup[]
  budgets          SpendingBudget[]
  accounts         Account[]
}

model SpaceMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId String
  userId  String
  role    SpaceRole

  space Space @relation(fields: [spaceId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId])
}

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
}

model SpendingCategory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId     String
  groupId     String?
  name        String
  color       String  @default("#ccc")
  icon        String
  isExclusive Boolean @default(false)

  space  Space                  @relation(fields: [spaceId], references: [id])
  group  SpendingCategoryGroup? @relation(fields: [groupId], references: [id])
  budget SpendingBudget?
}

model SpendingCategoryGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId String
  name    String
  color   String @default("gray")

  space      Space              @relation(fields: [spaceId], references: [id])
  categories SpendingCategory[]
}

model SpendingBudget {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId     String
  categoryId  String   @unique
  amount      Float    @default(0)
  isRecurring Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime

  space    Space            @relation(fields: [spaceId], references: [id])
  category SpendingCategory @relation(fields: [categoryId], references: [id])

  @@unique([spaceId, categoryId])
}

model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId     String
  type        AccountType
  name        String
  institution String?
  color       String      @default("gray")
  lastDigits  String?
  balance     Float       @default(0)
  creditLimit Float?

  space Space @relation(fields: [spaceId], references: [id])
}

enum AccountType {
  CASH_MANUAL
  DEBIT_MANUAL
  CREDIT_MANUAL
}
